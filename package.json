{
  "name": "rm-client",
  "version": "1.1.4",
  "description": "Desktop Redmine client for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/set-dev-icon.js && node scripts/copy-tinymce.js",
    "set-dev-icon": "node scripts/set-dev-icon.js",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:editor": "node scripts/copy-tinymce.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "tinymce": "^7.9.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "rcedit": "^4.0.1",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "ru.grandproject.rmclient",
    "productName": "RM Client",
    "directories": {
      "output": "C:/Temp/RMClientDist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!renderer/uploads/**",
      "!renderer/Redmine Client Options.dc.html",
      "!renderer/support.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/uninstaller.nsh"
    }
  }
}
